# Safe default: never publish to the public channel during setup.
REVIEW_MODE=true
TELEGRAM_CHANNEL=@GVOZDIchKAAA
REVIEW_CHAT_ID=
TELEGRAM_BOT_TOKEN=

# Optional. Without a key the rule-based fallback remains operational.
LLM_PROVIDER=openai
LLM_API_KEY=
